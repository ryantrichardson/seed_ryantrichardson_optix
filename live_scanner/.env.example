# Copy to .env and fill in
MASSIVE_API_KEY=your_key_here

# Comma-separated tickers to watch
TICKERS=TSLA,AMD,NVDA,PLTR,SHOP

# Block tape filter
MIN_BLOCK_NOTIONAL=100000

# Optional: webhook URL for wick alerts (Discord, Slack, Pushover, etc).
# Leave blank to only log alerts to console and disk.
WICK_WEBHOOK_URL=
